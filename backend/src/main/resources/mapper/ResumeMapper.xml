<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.htmlresume.mapper.ResumeMapper">

    <!-- Resume with modules ordered by sort_order -->
    <resultMap id="ResumeWithModulesResultMap" type="java.util.Map">
        <result column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="style_id" property="styleId"/>
        <result column="style_config" property="styleConfig"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <collection property="modules" ofType="com.htmlresume.entity.ResumeModule" columnPrefix="module_">
            <result column="id" property="id"/>
            <result column="resume_id" property="resumeId"/>
            <result column="module_type" property="moduleType"/>
            <result column="config_id" property="configId"/>
            <result column="content" property="content"/>
            <result column="sort_order" property="sortOrder"/>
            <result column="created_at" property="createdAt"/>
            <result column="updated_at" property="updatedAt"/>
        </collection>
    </resultMap>

    <select id="selectResumeWithModules" resultMap="ResumeWithModulesResultMap">
        SELECT
            r.id,
            r.user_id,
            r.title,
            r.style_id,
            r.style_config,
            r.created_at,
            r.updated_at,
            rm.id AS module_id,
            rm.resume_id AS module_resume_id,
            rm.module_type AS module_module_type,
            rm.config_id AS module_config_id,
            rm.content AS module_content,
            rm.sort_order AS module_sort_order,
            rm.created_at AS module_created_at,
            rm.updated_at AS module_updated_at
        FROM resume r
        LEFT JOIN resume_module rm ON r.id = rm.resume_id
        WHERE r.id = #{resumeId}
        ORDER BY rm.sort_order ASC
    </select>

    <!-- Resume with style info -->
    <resultMap id="ResumeWithStyleResultMap" type="java.util.Map">
        <result column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="style_id" property="styleId"/>
        <result column="style_config" property="styleConfig"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <association property="style" javaType="com.htmlresume.entity.CssStyle" columnPrefix="style_">
            <result column="id" property="id"/>
            <result column="name" property="name"/>
            <result column="description" property="description"/>
            <result column="thumbnail" property="thumbnail"/>
            <result column="css_content" property="cssContent"/>
            <result column="is_builtin" property="isBuiltin"/>
            <result column="is_active" property="isActive"/>
            <result column="created_at" property="createdAt"/>
            <result column="updated_at" property="updatedAt"/>
        </association>
    </resultMap>

    <select id="selectResumeWithStyle" resultMap="ResumeWithStyleResultMap">
        SELECT
            r.id,
            r.user_id,
            r.title,
            r.style_id,
            r.style_config,
            r.created_at,
            r.updated_at,
            cs.id AS style_id,
            cs.name AS style_name,
            cs.description AS style_description,
            cs.thumbnail AS style_thumbnail,
            cs.css_content AS style_css_content,
            cs.is_builtin AS style_is_builtin,
            cs.is_active AS style_is_active,
            cs.created_at AS style_created_at,
            cs.updated_at AS style_updated_at
        FROM resume r
        LEFT JOIN css_style cs ON r.style_id = cs.id
        WHERE r.id = #{resumeId}
    </select>

    <!-- Query modules for a resume ordered by sort_order -->
    <select id="selectModulesByResumeId" resultType="com.htmlresume.entity.ResumeModule">
        SELECT
            id,
            resume_id,
            module_type,
            config_id,
            content,
            sort_order,
            created_at,
            updated_at
        FROM resume_module
        WHERE resume_id = #{resumeId}
        ORDER BY sort_order ASC
    </select>

</mapper>
